{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "tasks": {
    "build":{
      "dependsOn": ["^build"],
      "env": ["VITE_API_URL"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev":{
      "cache": false,
      "persistent": true
    },
    "lint":{
      "dependsOn":["^lint"]
    },
    "test": {
      "cache": false
    }
  }
}
